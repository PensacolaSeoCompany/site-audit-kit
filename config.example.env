# config.example.env: copy to config.env (gitignored) and edit. kit-paths.sh reads config.env on every
# run. Format: plain KEY=value lines, no "export", no shell code; a variable already set in the
# environment wins over this file. Every line is optional: the defaults below are what the kit uses
# when the line is absent.

# ── folders ──────────────────────────────────────────────────────────────────────────────────
# KIT_WORK=./work                 # scratch + run state (crawl JSON, case folders, backups, queue locks)
# CRAWL_DIR=$KIT_WORK/crawl       # crawl JSON, Lighthouse JSON, findings sidecars
# CASES_DIR=$KIT_WORK/cases       # one folder per audit slug: run logs, evidence, site-audit.html
# REPORTS_DIR=./reports           # publish target: reports/<domain>/
# QUEUE_DIR=./queue               # run-queue.sh spool folders
# PUBLISH_BACKUP_DIR=$KIT_WORK/publish-backups
# (write absolute paths here: this file is not run through a shell, so $VARS are not expanded)

# ── tools ────────────────────────────────────────────────────────────────────────────────────
# PY=/path/to/python              # default: ./.venv/bin/python if present, else python3
# NODE=/path/to/node              # default: node on PATH
# CHROME_BIN=/usr/bin/google-chrome   # default: work/chrome-bin, else the first Chrome/Chromium on PATH

# ── audit run ────────────────────────────────────────────────────────────────────────────────
# AUDIT_MIN_FREE_GB=2             # stop before a run when less disk is free; nothing is ever deleted
# BIG_CRAWL=0                     # 1 = long crawl timeouts (4 h + 3 h fallback) for very large sites
# CHECK_EXTERNAL=0                # 1 = HEAD-check every external link (slow; no stage uses it yet)
# SKIP_PERF=0                     # 1 = reuse existing Lighthouse JSON instead of running Lighthouse
# CSR=0                           # 1 = the site is client-rendered; continue on a thin raw crawl

# ── polite crawl defaults (exported by kit-paths.sh to every stage) ───────────────────────────
# CRAWL_MAXP=500                  # page cap per audit (hitting it marks the run PARTIAL)
# CRAWL_CONCURRENCY=2             # parallel requests to the audited site
# CRAWL_DELAY=1                   # seconds between requests (the PROXY queue flag raises it to >= 3)
# CRAWL_UA=GrokBot-SiteAudit (+https://github.com/PensacolaSeoCompany/site-audit-kit)
# PERF_TIER_TIMEOUT=300           # seconds per Lighthouse tier

# ── crawl transport (bot-walled sites only) ──────────────────────────────────────────────────
# CRAWL_PROXY=http://user:pass@proxy.example:8080   # site crawl only; also needed by the PROXY queue flag
# (HTTP_PROXY/HTTPS_PROXY/ALL_PROXY are unset for each audit run, with a note)

# ── queue ────────────────────────────────────────────────────────────────────────────────────
# QUEUE_WORKERS=4                 # parallel audits; on a small machine use the core count or fewer
# QUEUE_POLL_S=5
# QUEUE_HEARTBEAT_S=30
# QUEUE_DISK_SLEEP_S=60

# ── publishing ───────────────────────────────────────────────────────────────────────────────
# KIT_RULES=./report-rules.json   # banned-text rules publish-run.sh enforces (absolute path)
