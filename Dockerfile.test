# Test image: the kit on a fresh Ubuntu 24.04, installed by install.sh as a non-root user.
# Base image site-audit-kit-base (built separately): ubuntu:24.04 + ca-certificates curl python3 python3-venv
# xz-utils + Chrome runtime shared libraries + Node 20 (NodeSource) + user `bot` (home /home/bot). NO Chrome.
#   docker build -f Dockerfile.test -t site-audit-kit-test .
#   docker run --rm --shm-size=1g site-audit-kit-test      (runs tests/test_install_audit.sh: install, re-install, doctor, smoke)
FROM site-audit-kit-base
COPY --chown=bot:bot . /home/bot/site-audit-kit
WORKDIR /home/bot/site-audit-kit
USER bot
CMD ["bash", "tests/test_install_audit.sh"]
